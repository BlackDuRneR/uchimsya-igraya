<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="28dp"/>
            <solid android:color="#F20A0B12"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="28dp"/>
            <gradient android:type="radial" android:gradientRadius="220dp" android:centerX="0.0" android:centerY="0.0"
                android:startColor="#55FF4D6D" android:endColor="#00FF4D6D"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="28dp"/>
            <gradient android:type="radial" android:gradientRadius="200dp" android:centerX="1.0" android:centerY="1.0"
                android:startColor="#30FF7AB6" android:endColor="#00FF7AB6"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="28dp"/>
            <stroke android:width="1dp" android:color="#26FFFFFF"/>
        </shape>
    </item>
</layer-list>
