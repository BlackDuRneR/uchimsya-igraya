<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="19dp"/>
            <gradient android:angle="315" android:startColor="#FF8B7CFF" android:endColor="#FFE07CFF"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="19dp"/>
            <gradient android:type="radial" android:gradientRadius="48dp" android:centerX="0.25" android:centerY="0.05"
                android:startColor="#66FFFFFF" android:endColor="#00FFFFFF"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="19dp"/>
            <stroke android:width="1dp" android:color="#33FFFFFF"/>
        </shape>
    </item>
</layer-list>
