  "space": [
    4,
    8,
    12,
    16,
    20,
    24,
    32,
    40,
    56
  ],
  "radius": {
    "s": 10,
    "m": 16,
    "l": 24,
    "pill": 999,
    "note": "s — чипы и поля, m — строки и плитки, l — листы и крупные блоки"
  },
  "stroke": {
    "hairline": 1,
    "icon": 1.75,
    "illustration": 2
  },
  "elevation": {
    "flat": "border 1dp",
    "float": "0 8 24 rgba(46,53,49,.08) — только FAB, листы, снекбар"
  },
  "touch": {
    "min": 48
  },
  "motion": {
    "press": {
      "ms": 120,
      "easing": "standard"
    },
    "state": {
      "ms": 200,
      "easing": "standard"
    },
    "enter": {
      "ms": 280,
      "easing": "emphasized-decelerate"
    },
    "progress": {
      "ms": 450,
      "easing": "standard"
    },
    "easing": {
      "standard": [
        0.2,
        0,
        0,
        1
      ],
      "emphasized-decelerate": [
        0.05,
        0.7,
        0.1,
        1
      ]
    }
  },
  "icon": {
    "grid": 24,
    "live": "2–22",
    "stroke": 1.75,
    "cap": "round",
    "join": "round",
    "style": "outline"
  }
}