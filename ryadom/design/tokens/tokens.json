      "tracking": -0.4
    },
    "headline": {
      "font": "display",
      "size": 24,
      "line": 30,
      "weight": 500,
      "tracking": -0.2
    },
    "title": {
      "font": "text",
      "size": 18,
      "line": 24,
      "weight": 600
    },
    "subtitle": {
      "font": "text",
      "size": 16,
      "line": 22,
      "weight": 600
    },
    "body": {
      "font": "text",
      "size": 16,
      "line": 24,
      "weight": 400
    },
    "body-s": {
      "font": "text",
      "size": 14,
      "line": 20,
      "weight": 400
    },
    "label": {
      "font": "text",
      "size": 14,
      "line": 18,
      "weight": 500,
      "tracking": 0.1
    },
    "caption": {
      "font": "text",
      "size": 13,
      "line": 16,
      "weight": 500,
      "tracking": 0.2
    },
    "numeric": {
      "font": "text",
      "feature": "tnum",
