<?xml version="1.0" encoding="utf-8"?>
<!-- Данные о здоровье не уходят в облачный бэкап Google и не переносятся на другое устройство без ведома пользователя.
     Резервная копия делается явно: Настройки → Приватность → Экспорт. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </device-transfer>
</data-extraction-rules>
