<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="ry_bg">#F6F5F0</color>

    <style name="Theme.Ryadom" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/ry_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.Ryadom.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/ry_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_mark</item>
        <item name="postSplashScreenTheme">@style/Theme.Ryadom</item>
    </style>
</resources>
